# 环境变量
# 未填写的会使用 src/config.ts 中的默认值

# 是否使用前端 mock 数据
# true: 使用 mock 数据
# false: 需要启动后端服务
VITE_USE_MOCK=false

# 后端 API 地址
# 开发环境，不需要，走 proxy 转发到 localhost:8787 或指定地址
# 生产环境，和后端同域名时也不需要
# 其他情况填写完整地址，如 https://your-backend:port
# VITE_API_URL=https://your-backend:port

# 腾讯位置服务
# https://lbs.qq.com/dev/console/application/mine
VITE_TENCENT_MAP_APP_NAME=my-app
VITE_TENCENT_MAP_KEY=XXXXX-XXXXX-XXXXX-XXXXX-XXXXX-XXXXX

# 反馈问卷地址
VITE_SURVEY_URL=https://your-survey-url

# 联系邮箱
VITE_CONTACT_EMAIL=your-email@example.com

# 旧版页面地址
VITE_CLASSIC_VER_URL=https://your-classic-version-url
