{
  "name": "web",
  "version": "5.2.0",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "format": "prettier --write --ignore-path .gitignore \"src/**/*.{vue,js,ts,json,html,css,less,scss,md}\"",
    "build": "vue-tsc --noEmit && vite build"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "echarts": "^6.1.0",
    "floating-vue": "^5.2.2",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-echarts": "^8.0.1",
    "vue-router": "^5.2.0",
    "vue-scroll-picker": "^2.0.1",
    "vuetify": "^4.1.5"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "less": "^4.8.0",
    "mockjs": "^1.1.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.03",
    "vite": "^8.1.5",
    "vite-plugin-mock": "^3.0.2",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "singleAttributePerLine": true,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": "*.json",
        "options": {
          "singleQuote": false
        }
      }
    ]
  }
}
